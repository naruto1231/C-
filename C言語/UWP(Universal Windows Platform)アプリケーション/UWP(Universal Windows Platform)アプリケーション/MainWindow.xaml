            <Grid Height="868.04" Width="1166">
                <CheckBox Content="CheckBox" Margin="140,186,0,0" Height="68" Width="115" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <Image Height="100" Margin="659,88,0,0" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left"/>
